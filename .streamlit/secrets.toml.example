# Streamlit Secrets Configuration
# Copy this to secrets.toml and fill in your credentials
# DO NOT commit secrets.toml to git!
# Peninsula uses Brevo (smtp-relay.brevo.com). Verify sender in Brevo and add DNS records.

# Peninsula Publishing Press (Brevo) - default
[publishers.peninsula]
name = "Peninsula Publishing Press"
smtp_server = "smtp-relay.brevo.com"
smtp_port = 587
use_ssl = false

[[publishers.peninsula.accounts]]
email = "editorial-office@peninsula-press.ae"
password = "YOUR_BREVO_SMTP_KEY"
smtp_login = "YOUR_BREVO_SMTP_LOGIN"
