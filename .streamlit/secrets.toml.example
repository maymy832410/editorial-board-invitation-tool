# Streamlit Secrets Configuration
# Copy this to secrets.toml and fill in your credentials
# DO NOT commit secrets.toml to git!
# Both publishers use Brevo (smtp-relay.brevo.com) with the same SMTP login and key.
# Verify each sender in Brevo and add DNS records for each domain.

# Peninsula Publishing Press via Brevo (default email sender)
[publishers.brevo]
name = "Peninsula Publishing Press"
smtp_server = "smtp-relay.brevo.com"
smtp_port = 587
use_ssl = false

[[publishers.brevo.accounts]]
email = "editorial-office@peninsula-press.ae"
password = "YOUR_BREVO_SMTP_KEY"
smtp_login = "YOUR_BREVO_SMTP_LOGIN"

# Mesopotamian Academic Press via Brevo (same Brevo account, different sender)
[publishers.mesopotamian]
name = "Mesopotamian Academic Press"
smtp_server = "smtp-relay.brevo.com"
smtp_port = 587
use_ssl = false

[[publishers.mesopotamian.accounts]]
email = "editorial@mesopotamian.press"
password = "YOUR_BREVO_SMTP_KEY"
smtp_login = "YOUR_BREVO_SMTP_LOGIN"
